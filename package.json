{
  "name": "viata-parintelui-cleopa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Atelierul de animație Viața Părintelui Cleopa și biblioteca de producție.",
  "scripts": {
    "preview": "node tools/studio-preview.mjs",
    "test": "node --test tests/*.test.mjs",
    "setup": "bash scripts/setup.sh",
    "build": "node tools/build-studio.mjs",
    "check:cleopa": "bash scripts/check-cleopa.sh",
    "feedback:export": "node tools/feedback-export.mjs",
    "check:preview": "node tools/check-preview.mjs",
    "runpod": "node tools/runpod.mjs",
    "render:scene": "node tools/render-assembly.mjs",
    "sheet": "node tools/sheet.mjs",
    "render:volum": "node tools/render-volum.mjs",
    "build:volum": "blender -b --factory-startup --python-exit-code 1 --python experiments/cleopa-volum/scripts/build_volum.py && python3 experiments/cleopa-volum/scripts/foi.py",
    "cadru": "node tools/cadru.mjs",
    "assets": "blender -b --factory-startup --python-exit-code 1 --python blender/characters/build_characters.py && blender -b --factory-startup --python-exit-code 1 --python blender/sets/build_sets.py",
    "stills": "node tools/engine/stills.mjs",
    "check:engine": "node tools/engine/check.mjs",
    "compare": "python3 tools/engine/compare.py",
    "export:mp4": "node tools/engine/export-mp4.mjs"
  },
  "dependencies": {
    "@vercel/blob": "^2.9.0",
    "three": "0.187.0"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.65.1"
  }
}
